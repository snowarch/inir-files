#!/usr/bin/env bash
# inir-files [PATH|URI]...: each place opens in a window of the running iNiR Files, which starts when none runs.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [ -f "$here/shell.qml" ]; then
    shell="$here/shell.qml"
elif [ -f "$here/share/inir-files/shell.qml" ]; then
    shell="$here/share/inir-files/shell.qml"
else
    echo "inir-files: shell.qml not found under $here" >&2
    exit 1
fi

# The app runs on qs-rs, the iNiR runtime: a stock Quickshell lacks what it uses.
qsrs() { [ -x "$1" ] && case $("$1" --version 2>/dev/null) in *qs-rs*) true ;; *) false ;; esac; }
qs=${INIR_FILES_QS:-}
if [ -n "$qs" ]; then
    qsrs "$qs" || { echo "inir-files: $qs is not qs-rs, the iNiR runtime" >&2; exit 1; }
else
    for c in "${XDG_DATA_HOME:-$HOME/.local/share}/inir/runtime/current/bin/qs" "$(command -v qs || true)"; do
        if [ -n "$c" ] && qsrs "$c"; then qs=$c; break; fi
    done
fi
[ -n "$qs" ] || { echo "inir-files: needs qs-rs, the iNiR runtime; install iNiR or set INIR_FILES_QS" >&2; exit 1; }
export INIR_FILES_QS=$qs   # the core calls the iNiR shell with the same runtime

core=${INIR_FILES_CORE:-}
if [ -z "$core" ]; then
    for c in "$here/libexec/inir-files-core" "$here/lib/inir-files/inir-files-core" "$here/core/target/release/inir-files-core"; do
        if [ -x "$c" ]; then core=$c; break; fi
    done
fi
if [ -z "$core" ] || [ ! -x "$core" ]; then
    echo "inir-files: core binary not found; build it with: cargo build --release --manifest-path $here/core/Cargo.toml" >&2
    exit 1
fi
export INIR_FILES_CORE=$core

# D-Bus starts the app for org.freedesktop.FileManager1 ("inir-files --service"): it stays in the foreground, as the
# bus wants, and the call that woke it opens the window. A running instance already serves the name.
if [ "${1:-}" = --service ]; then
    "$qs" ipc -p "$shell" show >/dev/null 2>&1 && exit 0
    INIR_FILES_SERVICE=1 exec "$qs" -n -p "$shell"
fi

# A file:// URI from a desktop entry becomes a plain path.
places=()
for a in "$@"; do
    case $a in
        file://*) a=${a#file://}; a=/${a#*/}; a=$(printf "%b" "${a//%/\\x}") ;;
        *) [ -e "$a" ] && a=$(readlink -f -- "$a") ;;
    esac
    places+=("$a")
done

# One process holds every window: a running one takes the places over IPC.
if "$qs" ipc -p "$shell" show >/dev/null 2>&1; then
    if [ ${#places[@]} -eq 0 ]; then
        exec "$qs" ipc -p "$shell" call files newWindow
    fi
    for p in "${places[@]}"; do "$qs" ipc -p "$shell" call files open "$p"; done
    exit 0
fi

first=${places[0]:-}
INIR_FILES_OPEN=$first "$qs" -n -d -p "$shell"
# The rest wait until the new instance answers.
for p in "${places[@]:1}"; do
    for _ in $(seq 50); do "$qs" ipc -p "$shell" show >/dev/null 2>&1 && break; sleep 0.1; done
    "$qs" ipc -p "$shell" call files open "$p"
done
